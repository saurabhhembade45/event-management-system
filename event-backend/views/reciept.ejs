<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Receipt</title>
</head>
<body>

  <h1><%= eventName %></h1>
  <h3>Event Registration Receipt</h3>

  <div class="card">
    <p><b>Event ID:</b> <%= eventId %></p>
    <p><b>Status:</b> Registered</p>
    <p><b>Date:</b> <%= date %></p>

    <p style="text-align:center;">
      Thank you for registering!
    </p>
  </div>

</body>
</html>